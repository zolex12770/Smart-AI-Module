{
  "name": "@ai-platform/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsc -b ../shared",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:e2e": "npm run build:e2e && next start -p 3100",
    "test:e2e": "playwright test",
    "build:e2e": "node -e \"process.env.NEXT_PUBLIC_API_URL=process.env.E2E_API_URL||'http://127.0.0.1:8790';require('child_process').execSync('npx next build',{stdio:'inherit',env:process.env})\""
  },
  "dependencies": {
    "@ai-platform/shared": "*",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
