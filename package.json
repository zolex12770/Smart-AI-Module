{
  "name": "ai-agent-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/providers/*"
  ],
  "scripts": {
    "predev": "npm run build:packages",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @ai-platform/api\" \"npm run dev -w @ai-platform/web\"",
    "build:packages": "tsc -b tsconfig.json",
    "build": "npm run build:packages && npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @ai-platform/database",
    "db:migrate": "npm run db:migrate -w @ai-platform/database"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
