# Copy to .env (here at the repo root, or as backend/.env) and fill in as needed. Both
# locations are loaded natively by the backend at boot (docs/26_DECISIONS.md ADR-043); a real
# environment variable always wins over a file value; nothing is loaded under NODE_ENV=test.
# Nothing here is required — the app runs entirely on the mock LLM provider and a real
# embedded PostgreSQL instance (PGlite, no install needed) with none of these set.
# See docs/26_DECISIONS.md and README.md. Never commit a .env with real values (gitignored).
#
# EVERY VARIABLE IS TAGGED, so you can tell what a deployment must set from what it may:
#   [REQUIRED]   the platform will not run correctly without it (there are none: see above)
#   [OPTIONAL]   safe default; set it to change behaviour
#   [LOCAL]      for development on one machine; not for a deployment
#   [PROD]       for a real deployment; ignored or wrong locally
#   [CREDENTIAL] a provider account's key — enables a hosted capability
#   [SECRET]     never commit a real value; inject it from a secret manager

# --- Process --------------------------------------------------------------------------------
NODE_ENV=development
PORT=8787
# Interface to listen on (ADR-113). Unset: 127.0.0.1 outside production, 0.0.0.0 in production.
# Set 0.0.0.0 only when other machines must reach a development server — they can then sign up.
# HOST=127.0.0.1
# all | api | worker — one image, three roles (ADR-039). Local dev must stay `all` (PGlite
# permits one process per data directory); Cloud Run sets api/worker per unit.
ROLE=all
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
# How many reverse proxies in front of this process may be trusted to have appended to
# X-Forwarded-For (ADR-112). 0 uses the connection's own address — right when nothing sits in
# front. Behind Cloud Run: 1. Higher than the real number lets a caller choose its own IP.
TRUST_PROXY_HOPS=0

# --- Database (ADR-025 / ADR-037) ------------------------------------------------------------
# Local embedded PostgreSQL (PGlite) data directory — the default.
DATABASE_DIR=./data/pgdata
# Set to use a REAL standalone Postgres (e.g. Cloud SQL) instead of PGlite.
# DATABASE_URL=postgresql://user:password@host:5432/ai_platform

# --- Files & assets (ADR-040 / ADR-041) ------------------------------------------------------
# The coding agent's workspace and the dev-only path-based RAG ingest root.
SANDBOX_ROOT=./data/sandbox
# Generated assets and uploaded documents on local disk — the default.
ASSETS_ROOT=./data/assets
# Set to store assets in a Google Cloud Storage bucket instead (Application Default Credentials).
# ASSETS_BUCKET=my-media-bucket
# Emulator-only: point the real GCS client at a local fake-gcs-server. Never set in production.
# GCS_API_ENDPOINT=http://127.0.0.1:4443

# --- Upload malware scanning (ADR-042, docs/13 §12) -------------------------------------------
# Set to enable: uploads are held in `scanning` until a real clamd (INSTREAM protocol) clears
# them. Unset: uploads are accepted unscanned with a durable scan_status=skipped_no_scanner.
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
# true ⇒ refuse uploads (503) when no scanner is configured, instead of accepting unscanned.
UPLOAD_SCAN_REQUIRED=false

# --- Long-form video (ADR-030) ---------------------------------------------------------------
# --- Speech / audio (ADR-079, ADR-114) --------------------------------------------------------
# [OPTIONAL] Which synthesiser answers POST /api/v1/audio and narrates long-form video.
#   piper  — offline, one static binary plus an ONNX voice; Linux, macOS and Windows. The only
#            offline path that exists on a server, and what a container should use.
#   sapi   — [LOCAL] the operating system's own synthesiser. Windows only.
#   openai — an HTTP synthesiser speaking /v1/audio/speech (OpenAI, Kokoro-FastAPI, LocalAI).
#   none   — no audio capability; POST /api/v1/audio answers 501 and video renders silent.
SPEECH_PROVIDER=none
# [OPTIONAL] piper: download a release from github.com/rhasspy/piper and a voice from
# huggingface.co/rhasspy/piper-voices (the .onnx and its .onnx.json must sit together).
# PIPER_PATH=/opt/piper/piper
# PIPER_VOICE=/opt/piper/voices/en_US-lessac-medium.onnx
# [OPTIONAL] openai-compatible synthesiser
# SPEECH_BASE_URL=http://127.0.0.1:8880/v1
# SPEECH_MODEL=tts-1
# [CREDENTIAL] [SECRET] only when the synthesiser is a hosted one
# SPEECH_API_KEY=
# [OPTIONAL] voice id understood by the chosen provider, e.g. "Microsoft Zira Desktop" for sapi
# SPEECH_VOICE=

# A real ffmpeg on PATH (or an explicit path) enables final MP4 assembly; without one every
# scene still generates and renderStatus honestly reports skipped_no_ffmpeg.
FFMPEG_PATH=ffmpeg

# --- Cost & quota (ADR-038, FR-063) — all optional, unset = no limit ------------------------
# [OPTIONAL] Speech is billed per character by every hosted synthesiser and costs a worker's
# attention locally, so it is budgeted in characters (ADR-114).
# DAILY_SPEECH_CHARACTER_LIMIT=200000
# MONTHLY_SPEECH_CHARACTER_LIMIT=2000000
# DAILY_TOKEN_LIMIT=200000
# MONTHLY_TOKEN_LIMIT=5000000
# DAILY_IMAGE_LIMIT=50
# MONTHLY_VIDEO_SECONDS_LIMIT=600

# --- SELF-HOSTED / PROVIDER-NEUTRAL AI RUNTIME (ADR-056) -------------------------------------
# [OPTIONAL] Leave BOTH unset on a machine already running Ollama and the platform finds it
# (ADR-118): it logs the runtime, chat model and embedding model it adopted. Detection never runs
# under NODE_ENV=production, where what answers users must be named explicitly.
# The platform does not require any third-party AI provider. Point these at ANY server that
# speaks the OpenAI-compatible `/v1` wire format and the whole system — chat, the agent loop,
# tool calling — runs locally with no external dependency:
#
#   Ollama      LLM_BASE_URL=http://127.0.0.1:11434/v1   LLM_MODEL=qwen2.5:14b
#   vLLM        LLM_BASE_URL=http://127.0.0.1:8000/v1    LLM_MODEL=<served model id>
#   LM Studio   LLM_BASE_URL=http://127.0.0.1:1234/v1    LLM_MODEL=<loaded model id>
#
# When set, this registers as the DEFAULT provider ahead of any hosted key below.
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=                      # only for gateways that require one
# LLM_CONTEXT_WINDOW=32768
# LLM_SUPPORTS_TOOLS=true           # set false for a model without function calling

# Real semantic embeddings from the same runtime. Without these RAG falls back to a
# deterministic LEXICAL embedding that matches on word overlap, not meaning — the API reports
# which one is active rather than implying semantic search it is not doing.
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768
# [CREDENTIAL] [SECRET] only when the embedding endpoint is a hosted one
# EMBEDDING_API_KEY=

# --- REAL IMAGE GENERATION (ADR-065) ----------------------------------------------------------
# Any server speaking OpenAI-compatible `/v1/images/generations`. Self-hosted options include
# LocalAI over Stable Diffusion and ComfyUI/Automatic1111 bridges; a hosted account works too.
# Unset means the platform has NO image capability and says so with a real 501 rather than
# returning a placeholder. In development, unset falls back to the clearly-labelled mock.
# IMAGE_BASE_URL=http://127.0.0.1:8080/v1
# IMAGE_MODEL=stable-diffusion
# IMAGE_API_KEY=
# IMAGE_SUPPORTS_NEGATIVE_PROMPT=true   # declare only what your server actually honours
# IMAGE_SUPPORTS_SEED=true

# --- LOCAL IMAGE GENERATION, no account needed (ADR-120) --------------------------------------
# [OPTIONAL] stable-diffusion.cpp runs a diffusion model on the CPU: one binary, one weights file,
# no server. With these set, POST /api/v1/images produces a REAL PNG instead of the mock's
# labelled placeholder. Binary: github.com/leejet/stable-diffusion.cpp releases. Weights: any
# .gguf or .safetensors, e.g. huggingface.co/Green-Sky/SD-Turbo-GGUF (SD-Turbo's licence is
# non-commercial — check the model card before deploying).
# On this machine a 512x512 SD-Turbo image takes about 45 s on four cores.
# IMAGE_SD_CLI_PATH=/opt/sdcpp/sd-cli
# IMAGE_SD_MODEL_PATH=/opt/sdcpp/models/sd_turbo-q8_0.gguf
# [OPTIONAL] SD-Turbo is distilled to ONE step at guidance 1.0; a standard model wants ~20 and 7.0.
# IMAGE_SD_STEPS=1
# IMAGE_SD_CFG_SCALE=1
# IMAGE_SD_SIZE=512
# IMAGE_SD_THREADS=4
# IMAGE_SD_TIMEOUT_MS=600000

# --- REAL VIDEO GENERATION (ADR-085) ----------------------------------------------------------
# Replicate's predictions API: one asynchronous API shape over hundreds of hosted video models,
# which is why this is the one video vendor an adapter can target without binding the platform
# to a single model. Unset means NO video capability and a real 501 — unchanged from before a
# real provider existed; in development, unset falls back to the GIF-producing mock (ADR-030).
# Setting VIDEO_PROVIDER without both other variables fails the boot rather than falling back.
# VIDEO_MODEL_VERSION is a version HASH, not a model name: Replicate pins reproducibility to the
# version, and the same name republished tomorrow is a different model.
# VIDEO_PROVIDER=replicate
# VIDEO_API_TOKEN=r8_...
# VIDEO_MODEL_VERSION=9f747673945c62801b13b84701c783929c0ee784e4748ec062204894dda1a351

# --- Security (ADR-049 / ADR-055) -------------------------------------------------------------
# [OPTIONAL] Signup/login attempts per 10 minutes from one address (login gets double).
# AUTH_RATE_LIMIT_MAX=5
# [PROD] Cookie SameSite. Derived from COOKIE_SECURE unless set: a deployed web app and API are
# different hostnames, so Lax would never send the cookie and nobody could sign in (ADR-070).
# COOKIE_SAMESITE=none
# [OPTIONAL] Hostnames web.fetch may reach, comma-separated. Unset means any PUBLIC address is
# allowed (private ranges are always refused). An allowlist is the answer to a prompt-injected
# agent using egress to exfiltrate (ADR-104).
# WEB_FETCH_ALLOWLIST=example.com,api.github.com
# Sessions are httpOnly cookies; Secure is forced on in production.
SESSION_TTL_DAYS=30
# COOKIE_SECURE=true
# Execution isolation for agent-run commands. `docker` gives a real container per run with no
# network, a read-only root, dropped capabilities and pid/memory/cpu caps. `process` is the
# development fallback (env-scrubbed and kill-on-timeout, but same-host) and is REFUSED in
# production unless SANDBOX_ALLOW_PROCESS_IN_PRODUCTION=true.
SANDBOX_RUNTIME=process
SANDBOX_IMAGE=node:22-alpine
SANDBOX_ALLOW_PROCESS_IN_PRODUCTION=false
SANDBOX_TIMEOUT_MS=30000
SANDBOX_MEMORY_MB=512
# Creates the first administrator on an EMPTY database, then is ignored forever.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=

# --- Agent limits (ADR-057) — ceilings the model cannot raise --------------------------------
# [OPTIONAL] Rolling conversation summarisation (FR-030, ADR-103/110): when the prompt passes
# CHAT_SUMMARY_MAX_PROMPT_TOKENS, turns older than the last CHAT_LIVE_WINDOW_MESSAGES are replaced
# by a running summary. The right values depend on the deployed model's context window.
# CHAT_SUMMARY_MAX_PROMPT_TOKENS=6000
# CHAT_LIVE_WINDOW_MESSAGES=10
# [OPTIONAL] MCP servers to connect at boot, as JSON (ADR-083). stdio spawns a command; http
# connects to a URL. Remote tools arrive DISABLED and must be enabled by an administrator.
# MCP_SERVERS=[{"id":"fs","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","./data/sandbox"]}]
# MCP_SERVERS=[{"id":"remote","transport":"http","url":"https://mcp.example.com/sse","headers":{"authorization":"Bearer ..."}}]
AGENT_MAX_ITERATIONS=12
AGENT_MAX_TOKENS_PER_RUN=200000

# --- Real LLM providers (ADR-010 / ADR-023) — set any one to use a real model instead of
# the mock; the first configured (in this order) becomes the default, with automatic
# fallback to the mock if a real call fails before producing output (ADR-024).
# See docs/04_MODEL_PROVIDER_RESEARCH.md and docs/28_API_PROVIDER_MATRIX.md.
# Uncomment and fill in ONE of these. They are commented rather than left blank on purpose:
# a bare `GOOGLE_API_KEY=` line sets the variable to the empty string, and an empty string is
# a *present* value to most code. That blank line used to silently shadow a real key set under
# the GEMINI_API_KEY alias (ADR-045); the config schema now maps empty to unset as well, but
# commented lines say what is meant.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENAI_ORG_ID=org-...
# OPENAI_PROJECT_ID=proj_...
# GOOGLE_API_KEY=AIza...
# GEMINI_API_KEY=AIza...        # accepted as an alias for GOOGLE_API_KEY; set one, not both

# --- Web app (build-time for production images; see frontend/Dockerfile) --------------------
NEXT_PUBLIC_API_URL=http://localhost:8787
