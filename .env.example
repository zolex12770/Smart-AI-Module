# Copy to .env and fill in as needed. Nothing here is required for Phase 1 —
# the app runs entirely on the mock LLM provider and a local SQLite file with none of
# these set. See docs/26_DECISIONS.md and README.md.

NODE_ENV=development
PORT=8787
DATABASE_FILE=./data/dev.sqlite
CORS_ORIGIN=http://localhost:3000

# Real LLM providers (optional — set any one to use a real model instead of the mock).
# See docs/04_MODEL_PROVIDER_RESEARCH.md and docs/28_API_PROVIDER_MATRIX.md.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Used by apps/web to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:8787
